{
  "name": "@qafila/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/jobs/worker.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "eval": "tsx --env-file-if-exists=../../.env src/pipeline/eval.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1156.0",
    "@aws-sdk/client-textract": "3.1156.0",
    "@hono/node-server": "1.19.17",
    "@hono/zod-validator": "0.7.6",
    "@qafila/chain": "workspace:*",
    "@qafila/contract-client": "workspace:*",
    "@qafila/shared": "workspace:*",
    "@stellar/stellar-sdk": "17.4.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
