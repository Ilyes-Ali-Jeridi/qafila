# Network
STELLAR_NETWORK=testnet                       # local | testnet | mainnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"   # same value; read by the stellar CLI when run from the repo root

# Contracts and tokens (written by scripts/deploy-testnet.ts; served to the web app by GET /config)
QAFILA_CONTRACT_ID=
QAFILA_E2E_CONTRACT_ID=                       # separate instance for Playwright (pnpm deploy:testnet --instance e2e)
SETTLEMENT_TOKEN_ID=                          # qUSD SAC on testnet, USDC on mainnet
SETTLEMENT_TOKEN_CODE=qUSD
SETTLEMENT_TOKEN_ISSUER=
QUSD_ISSUER_SECRET=                           # testnet only, mints faucet stock
X402_USDC_TOKEN_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
USDT0_TOKEN_ID=                               # mainnet value in PLAN 2.4; testnet uses the mock asset
CHARITY_ADDRESS=
TREASURY_ADDRESS=
REFLECTOR_FX_ID=CCSSOHTBL3LEWUCBBEB5NJFC2OKFRC74OWEIJIZLRJBGAAU4VMU5NV4W

# Keys (testnet only; mainnet uses multisig and KMS, never env files)
ADMIN_SECRET=
VERIFIER_ED25519_SECRET=                      # signs attestations; public key stored in contract
AGENT_SIGNER_SECRET=                          # signer of the agent smart account
AGENT_SMART_ACCOUNT_ID=
SHARE_ISSUER_FUNDER_SECRET=                   # funds new per-deal issuer accounts
FAUCET_SECRET=                                # testnet only, capped
DEMO_IMPORTER_SECRET=                         # testnet only; importer of the seeded demo deals (demo-reset rotates it)
DEMO_SUPPLIER_SECRET=                         # testnet only; payout account of the demo supplier (created by pnpm seed)
DEMO_INVESTOR_A_SECRET=                       # testnet only; demo investors that fund the shipping and late deals
DEMO_INVESTOR_B_SECRET=
PROBE_CONTRACT_ID=                            # contracts/spikes/probe on testnet (SP5, SP6)

# Smart accounts
SMART_ACCOUNT_WASM_HASH=                      # from smart-account-kit deployments doc for the current protocol
WEBAUTHN_VERIFIER_ADDRESS=
ED25519_VERIFIER_ADDRESS=                     # OZ ed25519 verifier contract for the agent smart account signer (SP6)
SP6_TARGET_CONTRACT_ID=                       # contracts/spikes/sp6/ping on testnet (SP6 evidence)
RELAYER_URL=
RELAYER_SECRET=                               # fee-paying key of the relayer proxy
APP_DOMAIN=qafila.dev                         # WebAuthn relying party ID; fixed before H9

# Public values for the web app (non-secret; the contract id is still read at runtime from GET /config)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_SMART_ACCOUNT_WASM_HASH=
NEXT_PUBLIC_WEBAUTHN_VERIFIER_ADDRESS=
NEXT_PUBLIC_RELAYER_URL=

# x402
X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
X402_FACILITATOR_API_KEY=                     # generate at https://channels.openzeppelin.com/testnet/gen
X402_PAYTO_ADDRESS=                           # classic G... account with a USDC trustline
X402_PRICE_USDC=0.50

# AI (AWS Bedrock, Qwen; the adapter also accepts LLM_PROVIDER=anthropic with ANTHROPIC_API_KEY)
LLM_PROVIDER=bedrock                          # bedrock | anthropic
AWS_REGION=us-east-1
LLM_MODEL_REASON=qwen.qwen3-vl-235b-a22b      # vision: extraction from page images, judgments
LLM_MODEL_FAST=qwen.qwen3-32b-v1:0            # classification, explanations
ANTHROPIC_API_KEY=

# External data
SHIPSGO_API_KEY=
OPENSANCTIONS_API_KEY=
QCC_API_KEY=                                  # optional; GLEIF needs no key
AISSTREAM_API_KEY=
FX_FALLBACK_URL=https://api.frankfurter.app
QCC_SECRET_KEY=                               # optional, with QCC_API_KEY
QCC_BASE_URL=https://api.qcckyc.com           # UNVERIFIED endpoint, see docs/SPIKES-intel.md
QCC_EKYB_PATH=/api/v1/cn/ekyb
ADAPTER_MODE=live                             # live | mock (per adapter overrides below)
SHIPSGO_MODE=                                 # mock until a key exists (SP8)
OPENSANCTIONS_MODE=                           # mock until a key exists
REGISTRY_MODE=                                # live (GLEIF, then QCC if keyed) | mock (data/fixtures/registry)
LLM_MODE=                                     # mock replays data/fixtures/llm (CI, pnpm eval offline)
REFLECTOR_MODE=
FX_MODE=
CHAIN_MODE=                                   # live | mock (in-memory chain for offline demos and tests)
STORAGE_MODE=supabase                         # supabase (private bucket `documents`) | local (data/uploads)
FIXTURES_DIR=                                 # default data/fixtures
UPLOADS_DIR=                                  # default data/uploads (local storage)
WORKER=true                                   # run the job loop (indexer, agent, notifications) in the API process
AGENT_DRY_RUN=false                           # true: the agent simulates and records, never submits
DEV_AUTH_BYPASS=false                         # non-production only: x-dev-user / x-dev-roles headers
RESEND_FROM=Qafila <notifications@qafila.dev>
OPS_EMAIL=                                    # incident mails when ops profiles have no email
INBUCKET_URL=http://127.0.0.1:54324           # local mail catcher for OTP codes (self-hosted Supabase)

# Deal economics used when the API builds DealTerms (caps enforced on-chain)
MARKUP_BPS=800
PLATFORM_FEE_BPS=200
LATE_FEE_BPS=100
SUPPLIER_DEPOSIT_BPS=3000
FUNDING_WINDOW_SECS=604800
ACCEPT_WINDOW_SECS=604800
BASE_IMPORTER_LIMIT=50000                     # test dollars, mock chain only (live reads the contract)
IMPORTER_LIMIT_STEP=10000
FAUCET_AMOUNT=50

# Trustless Work (S2, docs/SPIKES-s2.md). Live mode needs the API key; without it the adapter is mock.
TRUSTLESS_WORK_BASE_URL=https://dev.api.trustlesswork.com   # https://api.trustlesswork.com on mainnet
TRUSTLESS_WORK_API_KEY=
TRUSTLESS_WORK_MODE=                          # live | mock; defaults to ADAPTER_MODE, mock without a key
TRUSTLESS_WORK_FEE_BPS=30                     # protocol fee on every payout, measured in SP10 (0.3%)
TRUSTLESS_WORK_PLATFORM_ADDRESS=              # escrow owner (platform role, fee 0); defaults to the admin G key
TRUSTLESS_WORK_DISPUTE_RESOLVER=              # Sharia board multisig G account in production; defaults to the admin G key
TRUSTLESS_WORK_VIEWER_URL=https://viewer.trustlesswork.com

# App
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=                          # verifies GoTrue session tokens (HS256)
DATABASE_URL=
RESEND_API_KEY=
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8787
JWT_AUDIENCE=qafila
JWT_SECRET=

# Security deposit, co-invest, extensions (v1.1, docs/FLOWS.md section 9)
MIN_SECURITY_BPS=2000
SECURITY_STEP_BPS=250
SECURITY_FLOOR_BPS=1000
MAX_EXTENSION_SECS=600                        # testnet; 5184000 (60 days) on mainnet
COINVEST_BPS=500
COINVEST_SECRET=                              # testnet only, created by the deploy script
QAFILA_ENTITY_NAME=Qafila Trade

# Feature flags
FF_SUPPLIER_CONFIRM=false                     # true once S-1 works (FLOWS.md)
FF_EXTENSIONS=true
FF_COINVEST=true
FF_X402=true
FF_TRUSTLESS_WORK=false
FF_REFLECTOR=true
FF_TRADE_PASSPORT=true
FF_TRADE_FILE=true
FF_QR_JOIN=true
FF_USDT0_SWAP=false
FF_ANCHOR=false
FF_I18N=false
FF_AIS=false

# Web app and mock API (Track C). The browser reads only NEXT_PUBLIC_* values; everything chain-related
# still comes from GET /config at runtime.
NEXT_PUBLIC_MOCK_CHAIN=0                      # 1 = offline chain against the mock API (development and e2e only)
NEXT_PUBLIC_PASSKEY_PATH=direct               # direct (kit.signAndSubmit) | execute (kit.executeAndSubmit); SP5 passed both
NEXT_PUBLIC_PROBE_CONTRACT_ID=                # SP5 harness only (/dev/sp5 in development)
MOCK_API_PORT=8788                            # pnpm --filter ./apps/web mock-api
RELAYER_MAX_RESOURCE_FEE_STROOPS=1500000000   # Qafila relayer: resource fee cap per sponsored tx (testnet rent is high)
RELAYER_INCLUSION_FEE_STROOPS=10000           # Qafila relayer: inclusion fee bid
RELAYER_PER_IP_PER_MINUTE=30                  # Qafila relayer: rate limit
